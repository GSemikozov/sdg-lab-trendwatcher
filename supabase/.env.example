# Supabase Edge Functions environment (local dev via supabase functions serve)
OPENAI_API_KEY=sk-...
BREVO_API_KEY=xkeysib-...
EMAIL_SENDER=you@gmail.com
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
EMAIL_RECIPIENTS=you@example.com
SUBREDDITS=lonely,depression,socialskills

# Redlisten Free (preferred — no Reddit account)
# Sign up at https://app.redlisten.com (Free, no credit card).
# Over Free quota → requests pause until next UTC month; Pro is manual only (no auto-charge).
REDLISTEN_API_KEY=

# Shared secret for Netlify reddit-proxy ↔ Edge daily-report (server-to-server).
# Required on both Netlify and Supabase when using REDDIT_PROXY_URL / Redlisten via proxy.
# Generate: openssl rand -hex 32
REDDIT_PROXY_SECRET=

# Absolute URL of the deployed Netlify reddit-proxy (Supabase Edge secret).
# Example: https://sdg-lab-trendwatcher.netlify.app/.netlify/functions/reddit-proxy
REDDIT_PROXY_URL=

# Cron / all-spaces auth (Supabase Edge secret). Same value must exist in Vault as
# daily_report_cron_secret (migration 014 reads it into x-cron-secret at schedule time).
# Generate: openssl rand -hex 32
# Monthly Redlisten 429 is upstream enforcement (not an app-level pause across spaces).
CRON_SECRET=

# Optional: legacy HS256 JWT secret (Dashboard → Settings → API → JWT Secret).
# Needed only to accept HS256 user tokens other than the exact SUPABASE_ANON_KEY value.
# ES256 session tokens verify via JWKS (SUPABASE_JWKS or /auth/v1/.well-known/jwks.json).
# SUPABASE_JWT_SECRET=
# JWT_SECRET=

# Optional Reddit OAuth — ONLY if you have a Reddit app. Not required for Redlisten Free.
# Without these, failed-batch recovery uses public RSS (currently dead) / skips OAuth.
# If set, configure the same pair on Netlify for proxy-side OAuth recovery.
# Create app at https://www.reddit.com/prefs/apps (type: script) if you use it.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
