# Frontend (exposed to browser via Vite)
VITE_SUPABASE_URL=https://xxxxx.supabase.co

# Use the legacy anon JWT (Dashboard → Settings → API → anon public, starts with eyJ)
# as VITE_SUPABASE_ANON_KEY so PostgREST and Edge Functions both work.
# If you use sb_publishable_* here, set VITE_SUPABASE_ANON_JWT to the same eyJ... JWT
# or weekly/daily generation will get 401 from the Functions gateway.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional: only when ANON_KEY must stay publishable for some reason
# VITE_SUPABASE_ANON_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Local dev overrides go in .env.local (git-ignored, auto-loaded by Vite)
# See .env.local for VITE_FUNCTIONS_URL
