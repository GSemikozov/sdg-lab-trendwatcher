# Frontend (exposed to browser via Vite)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Legacy anon JWT (Dashboard → Project Settings → API → anon public). Required for
# supabase.functions.invoke: the Edge gateway rejects sb_publishable_* with 401.
VITE_SUPABASE_ANON_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Local dev overrides go in .env.local (git-ignored, auto-loaded by Vite)
# See .env.local for VITE_FUNCTIONS_URL
